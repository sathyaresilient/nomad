{
  "expo": {
    "name": "Nomadly",
    "slug": "nomadly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nomadly",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0E2A"
    },
    "ios": {
      "bundleIdentifier": "com.nomadly.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Nomadly uses your location to find travelers nearby and show local experiences.",
        "NSCameraUsageDescription": "Nomadly needs camera access to verify your identity and share photos.",
        "NSPhotoLibraryUsageDescription": "Nomadly needs photo library access to share travel photos.",
        "NSPhotoLibraryAddUsageDescription": "Nomadly needs permission to save photos to your library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nomadly.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0E2A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Nomadly uses your location to find travelers nearby."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Nomadly needs camera access for identity verification."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nomadly needs access to your photos for sharing travel moments."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d3924380-0680-4994-a226-2cffd01ef908"
      }
    }
  }
}
