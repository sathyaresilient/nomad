# Environment
NODE_ENV=development

# API Gateway
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=0.0.0.0

# Database - PostgreSQL
DATABASE_URL=postgresql://nomadly:nomadly_dev@localhost:5432/nomadly_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Service URLs (for inter-service communication)
USER_SERVICE_URL=http://localhost:3001
SOCIAL_SERVICE_URL=http://localhost:3002
TRAVEL_SERVICE_URL=http://localhost:3003
CHAT_SERVICE_URL=http://localhost:3004
MEDIA_SERVICE_URL=http://localhost:3005

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=nomadly-media-dev

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Email (SendGrid/SES)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# Push Notifications
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Monitoring
SENTRY_DSN=
