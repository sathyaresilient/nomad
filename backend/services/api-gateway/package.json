{
    "name": "@nomadly/api-gateway",
    "version": "0.1.1",
    "private": true,
    "description": "Nomadly API Gateway - Central routing, auth, and rate limiting",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "npx prisma db push && node dist/index.js",
        "test": "vitest",
        "lint": "eslint src --ext .ts",
        "migrate": "prisma migrate dev",
        "migrate:prod": "prisma migrate deploy",
        "seed": "tsx src/scripts/seed.ts",
        "generate": "prisma generate"
    },
    "dependencies": {
        "@fastify/cors": "^9.0.0",
        "@fastify/helmet": "^11.0.0",
        "@fastify/jwt": "^8.0.0",
        "@fastify/rate-limit": "^9.0.0",
        "@fastify/swagger": "^8.0.0",
        "@fastify/swagger-ui": "^2.0.0",
        "@fastify/websocket": "^8.0.0",
        "@google-cloud/storage": "^7.18.0",
        "@prisma/client": "^5.7.0",
        "@sentry/node": "^8.55.0",
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.3.0",
        "fastify": "^4.25.0",
        "firebase-admin": "^12.7.0",
        "ioredis": "^5.3.0",
        "ioredis-mock": "^8.13.1",
        "jsonwebtoken": "^9.0.0",
        "pino": "^8.17.0",
        "pino-pretty": "^10.3.0",
        "uuid": "^9.0.0",
        "ws": "^8.16.0",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/ioredis-mock": "^8.2.6",
        "@types/jsonwebtoken": "^9.0.0",
        "@types/node": "^20.19.30",
        "@types/uuid": "^9.0.0",
        "@types/ws": "^8.5.0",
        "prisma": "^5.7.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.0",
        "vitest": "^1.1.0"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}