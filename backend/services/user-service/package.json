{
    "name": "@nomadly/user-service",
    "version": "0.1.0",
    "private": true,
    "description": "Nomadly User Service - Authentication, Profiles, Trust Scores",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "test": "vitest --passWithNoTests",
        "lint": "eslint src --ext .ts",
        "migrate": "prisma migrate dev",
        "migrate:prod": "prisma migrate deploy",
        "generate": "prisma generate",
        "proto:generate": "grpc_tools_node_protoc --plugin=protoc-gen-ts=../../node_modules/.bin/protoc-gen-ts --ts_out=src/generated --grpc_out=grpc_js:src/generated -I ../../shared/proto ../../shared/proto/*.proto"
    },
    "dependencies": {
        "@fastify/cors": "^9.0.0",
        "@fastify/helmet": "^11.0.0",
        "@fastify/jwt": "^8.0.0",
        "@grpc/grpc-js": "^1.9.0",
        "@grpc/proto-loader": "^0.7.0",
        "@prisma/client": "^5.7.0",
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.3.0",
        "fastify": "^4.25.0",
        "ioredis": "^5.3.0",
        "jsonwebtoken": "^9.0.0",
        "pino": "^8.17.0",
        "pino-pretty": "^10.3.0",
        "uuid": "^9.0.0",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.0",
        "@types/node": "^20.10.0",
        "@types/uuid": "^9.0.0",
        "grpc-tools": "^1.12.0",
        "grpc_tools_node_protoc_ts": "^5.3.0",
        "prisma": "^5.7.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.0",
        "vitest": "^1.1.0"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}